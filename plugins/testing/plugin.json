{
  "id": "testing",
  "name": "Gateway Testing",
  "version": "1.1.0",
  "sdkVersion": "^1.0.0",
  "type": "HYBRID",
  "description": "Chuyên đo kiểm Gateway và tự động hóa flow test kết nối ChirpStack server, giám sát luồng gói tin RF/Dual Payload.",
  "author": "ITEST IoT Platform Team",
  "entry": "dist/index.js",
  "enabledByDefault": true,
  "permissions": [
    {
      "namespace": "testing",
      "resource": "gateway-session",
      "action": "manage"
    },
    {
      "namespace": "testing",
      "resource": "packet",
      "action": "read"
    },
    {
      "namespace": "testing",
      "resource": "packet",
      "action": "write"
    }
  ],
  "ui": {
    "title": "Gateway Testing",
    "icon": "Odometer",
    "route": "/testing",
    "component": "GatewayTestingView",
    "slot": "main-navigation"
  },
  "defaultConfig": {
    "chirpstackServerUrl": "http://chirpstack:8080",
    "maxPacketsRetentionDays": 30,
    "enableLivePacketsStream": true
  }
}
